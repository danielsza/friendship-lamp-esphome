# Copy to secrets.yaml and fill in. secrets.yaml is ignored by git.
wifi_ssid: "your-wifi-name"
wifi_password: "your-wifi-password"
# 32 random bytes, base64. Generate with: openssl rand -base64 32
lamp_api_key: "REPLACE_WITH_BASE64_KEY"
lamp_ota_password: "choose-an-ota-password"
lamp_ap_password: "choose-a-fallback-hotspot-password"
